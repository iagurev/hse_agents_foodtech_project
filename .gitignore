.DS_Store

# Local secrets; safe examples remain visible.
.env
.env.*
!.env.example
!.env.*.example

# Development environments, caches and builds.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.impeccable/
.coverage
.coverage.*
htmlcov/
dist/
node_modules/
frontend/dist/
*.tsbuildinfo

# Only the three published catalogue databases belong in data.
data/*
!data/recipes.sqlite
!data/products.sqlite
!data/sources.sqlite
