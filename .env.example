OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PROVIDER=openai
MODEL=openai/gpt-6-luna
REASONING_EFFORT=medium
PLANNING_MODEL=openai/gpt-6-luna
PLANNING_PROVIDER=openai
PLANNING_REASONING_EFFORT=medium
DATABASE_PATH=../hse_agents_runtime/assistant.sqlite
VKUSVILL_MCP_URL=https://mcp.vkusvill.ru/mcp

# Chat context: max input = window - response reserve - counting margin.
CONTEXT_WINDOW_TOKENS=256000
RESPONSE_RESERVE_TOKENS=16000
TOKEN_COUNT_MARGIN=8000
COMPACTION_THRESHOLD_TOKENS=200000
SUMMARY_MAX_TOKENS=8000
COMPACTION_TIMEOUT_SECONDS=180
COMPACTION_REQUEST_LIMIT=2

# Task budget includes input guard; compaction has its own time/request budget.
REQUEST_LIMIT=12
TURN_TIMEOUT_SECONDS=600
MODEL_TIMEOUT_SECONDS=180
GUARD_MODEL=google/gemini-2.5-flash-lite
GUARD_TIMEOUT_SECONDS=60
INTEGRATION_TIMEOUT_SECONDS=60
IMAGE_TIMEOUT_SECONDS=20
IMAGE_MAX_BYTES=8388608
IMAGE_CACHE_SECONDS=86400
SESSION_DAYS=30
WEB_HOST=127.0.0.1
WEB_PORT=8080
FRONTEND_PATH=frontend/dist
LOG_LEVEL=INFO
RECIPES_DATABASE_PATH=data/recipes.sqlite
PRODUCTS_DATABASE_PATH=data/products.sqlite
SOURCES_DATABASE_PATH=data/sources.sqlite

# Local recipe RAG. Model/index prepare automatically at startup, outside data/.
RETRIEVAL_ENABLED=true
RETRIEVAL_DENSE_ENABLED=true
RETRIEVAL_CACHE_PATH=../hse_agents_runtime/retrieval
RETRIEVAL_MODEL_CACHE_PATH=../hse_agents_runtime/retrieval-model
RETRIEVAL_TIMEOUT_SECONDS=2.8
RETRIEVAL_THREADS=2

# Optional local tracing; keys belong to a Langfuse project, not OpenRouter.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://127.0.0.1:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=local

# Docker Compose only: public app port and Langfuse running on the host.
APP_PORT=8080
LANGFUSE_DOCKER_URL=http://host.docker.internal:3001
