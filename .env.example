OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PROVIDER=OpenInference
MODEL=z-ai/glm-5.3-flash
PLANNING_MODEL=openai/gpt-6-luna
PLANNING_PROVIDER=openai
PLANNING_REASONING_EFFORT=medium
DATABASE_PATH=../hse_agents_runtime/assistant.sqlite
VKUSVILL_MCP_URL=https://mcp.vkusvill.ru/mcp

# Chat context: max input = window - response reserve - counting margin.
CONTEXT_WINDOW_TOKENS=256000
RESPONSE_RESERVE_TOKENS=16000
TOKEN_COUNT_MARGIN=8000
COMPACTION_THRESHOLD_TOKENS=200000
SUMMARY_MAX_TOKENS=8000
COMPACTION_TIMEOUT_SECONDS=180
COMPACTION_REQUEST_LIMIT=2
TOKENIZER_CACHE_PATH=../hse_agents_runtime/tokenizer

# Task budget includes input guard; compaction has its own time/request budget.
REQUEST_LIMIT=12
TURN_TIMEOUT_SECONDS=600
MODEL_TIMEOUT_SECONDS=180
GUARD_MODEL=openai/gpt-oss-safeguard-20b
GUARD_TIMEOUT_SECONDS=60
INTEGRATION_TIMEOUT_SECONDS=60
SESSION_DAYS=30
WEB_HOST=127.0.0.1
WEB_PORT=8080
FRONTEND_PATH=frontend/dist
LOG_LEVEL=INFO
RECIPES_DATABASE_PATH=data/recipes.sqlite
PRODUCTS_DATABASE_PATH=data/products.sqlite
SOURCES_DATABASE_PATH=data/sources.sqlite
